extends layout

block content
  .wa-container
    //- LEFT PANEL: Contact List (No tabs)
    #wa-sidebar.wa-sidebar
      #wa-chat-list.wa-chat-list
        .loader(style='margin-top: 2rem')
          .spinner
          | Loading Alerts...

    //- RIGHT PANEL: The Chat
    #wa-chat-area.wa-chat-area
      #wa-chat-empty.wa-chat-empty
        div(style='text-align: center')
          svg(
            xmlns='http://www.w3.org/2000/svg',
            width='64',
            height='64',
            viewBox='0 0 24 24',
            fill='none',
            stroke='#a0aec0',
            stroke-width='1',
            stroke-linecap='round',
            stroke-linejoin='round',
            style='margin-bottom: 15px'
          )
            path(
              d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'
            )
          p Select a drug to view its alert history

      #wa-chat-view.wa-chat-view
        .wa-chat-header
          button.wa-back-btn(onclick='closeChat()') ←
          h3#chat-drug-title.wa-chat-drug-name Drug Name
        #wa-messages.wa-messages
          //- Bubbles go here

block scripts
  script.
    // ── GLOBALS & STATE ──
    let allAlerts = [];
    let groupedAlerts = {};
    let activeChatKey = null;
    const user = typeof getUser === 'function' ? getUser() : null;

    // ── ICONS (ESCAPED) ──
    const icons = {
      cross: '\x3csvg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"\x3e\x3cline x1="18" y1="6" x2="6" y2="18"\x3e\x3c/line\x3e\x3cline x1="6" y1="6" x2="18" y2="18"\x3e\x3c/line\x3e\x3c/svg\x3e',
    };

    // ── DATE HELPERS (WhatsApp Style) ──
    const getWhatsAppDateStr = (dateInput) => {
      const date = new Date(dateInput);
      const today = new Date();
      const yesterday = new Date(today);
      yesterday.setDate(yesterday.getDate() - 1);

      if (date.toDateString() === today.toDateString()) return 'Today';
      if (date.toDateString() === yesterday.toDateString()) return 'Yesterday';

      const diffTime = Math.abs(today - date);
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

      if (diffDays < 7) return date.toLocaleDateString('en-US', { weekday: 'long' });
      return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    };

    const formatTime = (dateString) => {
      return new Date(dateString).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
    };

    // ── DATA PROCESSING ──
    const loadAlerts = async () => {
      try {
        const r = await fetch('/api/alerts', { credentials: 'include' });
        const data = await r.json();
        allAlerts = data.alerts || [];

        groupedAlerts = {};
        allAlerts.forEach((a) => {
          const key = a.drug_name || 'System Alert';
          if (!groupedAlerts[key]) {
            groupedAlerts[key] = { drugName: key, alerts: [], unread: 0, latestTime: new Date(0), latestMsg: '' };
          }
          groupedAlerts[key].alerts.push(a);
        });

        for (const key in groupedAlerts) {
          const group = groupedAlerts[key];
          group.alerts.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));

          const latest = group.alerts[group.alerts.length - 1];
          group.latestTime = new Date(latest.created_at);

          if (latest.isTransfer) group.latestMsg = 'Network Transfer';
          else if (latest.type === 'ROP') group.latestMsg = 'Low Stock (ROP)';
          else group.latestMsg = 'Expiring Stock (FEFO)';

          group.unread = group.alerts.filter((a) => a.status === 'pending' && !a.is_read).length;
        }
        renderList();
        if (activeChatKey) openChat(activeChatKey, true);
      } catch (err) {
        document.getElementById('wa-chat-list').innerHTML = '\x3cdiv class="flash flash-error"\x3eFailed to load alerts\x3c/div\x3e';
      }
    };

    // ── UI RENDERING ──
    const renderList = () => {
      const listDiv = document.getElementById('wa-chat-list');
      let groupsArray = Object.values(groupedAlerts).sort((a, b) => b.latestTime - a.latestTime);

      if (groupsArray.length === 0) {
        listDiv.innerHTML = '\x3cdiv style="padding: 30px; text-align:center; color:#667781;"\x3eNo alerts available\x3c/div\x3e';
        return;
      }

      listDiv.innerHTML = groupsArray
        .map((g) => {
          const timeStr = getWhatsAppDateStr(g.latestTime) === 'Today' ? formatTime(g.latestTime) : getWhatsAppDateStr(g.latestTime);
          const activeClass = activeChatKey === g.drugName ? ' active' : '';

          return '\x3cdiv class="wa-drug-row' + activeClass + '" onclick="openChat(\'' + g.drugName.replace(/'/g, "\\'") + '\')"\x3e' + '\x3cdiv class="wa-drug-info"\x3e' + '\x3cdiv class="wa-drug-name"\x3e' + g.drugName + '\x3c/div\x3e' + '\x3cdiv class="wa-drug-preview"\x3e' + g.latestMsg + '\x3c/div\x3e' + '\x3c/div\x3e' + '\x3cdiv class="wa-drug-meta"\x3e' + '\x3cspan class="wa-time"\x3e' + timeStr + '\x3c/span\x3e' + (g.unread > 0 ? '\x3cspan class="wa-unread"\x3e' + g.unread + '\x3c/span\x3e' : '') + '\x3c/div\x3e' + '\x3c/div\x3e';
        })
        .join('');
    };

    window.openChat = async (drugKey, isQuietRefresh = false) => {
      activeChatKey = drugKey;
      const group = groupedAlerts[drugKey];
      if (!group) return;

      if (group.unread > 0) {
        try {
          await fetch('/api/alerts/read/' + encodeURIComponent(drugKey), { method: 'PATCH', credentials: 'include' });
          group.unread = 0;
        } catch (e) {
          console.error('Failed to mark read', e);
        }
      }

      if (window.innerWidth <= 768) {
        document.getElementById('wa-sidebar').classList.add('chat-open');
        document.getElementById('wa-chat-area').classList.add('chat-open');
      }

      if (!isQuietRefresh) renderList();

      document.getElementById('wa-chat-empty').style.display = 'none';
      document.getElementById('wa-chat-view').classList.add('visible');
      document.getElementById('chat-drug-title').textContent = group.drugName;

      const messagesDiv = document.getElementById('wa-messages');
      let html = '';
      let lastDateGroup = null;

      group.alerts.forEach(a => {
        const dateStr = getWhatsAppDateStr(a.created_at);
        
        if (dateStr !== lastDateGroup) {
            html += '\x3cdiv class="wa-date-sep"\x3e\x3cspan\x3e' + dateStr + '\x3c/span\x3e\x3c/div\x3e';
            lastDateGroup = dateStr;
        }

        const myFacStr = typeof user !== 'undefined' && user && user.facilityId ? String(user.facilityId) : '';
        const isSource = a.source_facility && String(a.source_facility._id) === myFacStr;
        const isTarget = a.target_facility && String(a.target_facility._id) === myFacStr;
        
        let typeClass = 'transfer';
        let typeLabel = 'NETWORK TRANSFER';
        
        if (!a.isTransfer) {
            if (a.type === 'ROP') { typeClass = 'rop'; typeLabel = 'LOW STOCK (ROP)'; } 
            else { typeClass = 'fefo'; typeLabel = 'EXPIRING STOCK (FEFO)'; }
        }

        let actionsHtml = '';
        if (!a.isTransfer && a.status === 'pending') {
            if (a.type === 'ROP') {
                actionsHtml = '\x3cbutton class="btn btn-action-primary" onclick="openNetworkModal(\'' + a.drug_id._id + '\', \'' + a.drug_name.replace(/'/g, "\\'") + '\', ' + a.quantity_needed + ', \'Standard Requisition\', \'ROP\')"\x3eRequest Stock\x3c/button\x3e' +
                              '\x3cbutton class="btn btn-action-secondary" onclick="doAlert(\'' + a._id + '\',\'self-resolve\')"\x3eSelf Resolve\x3c/button\x3e';
            } else {
                actionsHtml = '\x3cbutton class="btn btn-action-primary" onclick="openNetworkModal(\'' + a.drug_id._id + '\', \'' + a.drug_name.replace(/'/g, "\\'") + '\', ' + a.quantity_available + ', \'Discounted Offload\', \'FEFO\')"\x3ePush Discount\x3c/button\x3e' +
                              '\x3cbutton class="btn btn-action-secondary" onclick="doAlert(\'' + a._id + '\',\'self-resolve\')"\x3eSelf Resolve\x3c/button\x3e';
            }
        } else if (a.isTransfer) {
            if (a.status === 'pending' && isSource) {
                actionsHtml = '\x3cbutton class="btn btn-success" onclick="doAlert(\'' + a._id + '\',\'confirm\')"\x3eAccept\x3c/button\x3e' +
                              '\x3cbutton class="btn btn-danger" onclick="doAlert(\'' + a._id + '\',\'decline\')"\x3eDecline\x3c/button\x3e';
            }
            if (a.status === 'confirmed' && isSource) {
                actionsHtml = '\x3cbutton class="btn btn-primary" onclick="doAlert(\'' + a._id + '\',\'dispatch\')"\x3eMark Dispatched\x3c/button\x3e';
            }
            if (a.status === 'dispatched' && isTarget) {
                actionsHtml = '\x3cbutton class="btn btn-success" onclick="resolveWithBatch(\'' + a._id + '\')"\x3eConfirm Receipt\x3c/button\x3e';
            }
        }

        // ── PREMIUM CARD-STYLE BUBBLE ──
        html += '\x3cdiv class="wa-bubble ' + typeClass + '"\x3e' +
                  '\x3cdiv class="wa-bubble-header"\x3e' +
                    '\x3cspan class="wa-bubble-type ' + typeClass + '"\x3e' + typeLabel + '\x3c/span\x3e' +
                    '\x3cspan class="wa-badge-status badge-' + (a.status === 'pending' ? 'pending' : 'resolved') + '"\x3e' + a.status + '\x3c/span\x3e' +
                  '\x3c/div\x3e' +
                  '\x3cdiv class="wa-bubble-body"\x3e' +
                     '\x3cp style="margin-bottom: 8px;"\x3e' + (a.notes || 'System Alert triggered.') + '\x3c/p\x3e' +
                     (a.quantity_available ? '\x3cdiv style="display:inline-block; background:#f8fafc; padding: 4px 10px; border-radius: 6px; font-size: 0.85rem; font-weight:600; color:#475569; border: 1px solid #e2e8f0;"\x3eAvailable: ' + a.quantity_available + ' units\x3c/div\x3e' : '') +
                  '\x3c/div\x3e' +
                  (actionsHtml ? '\x3cdiv class="wa-bubble-actions"\x3e' + actionsHtml + '\x3c/div\x3e' : '') +
                  '\x3cdiv class="wa-bubble-footer"\x3e' +
                     '\x3cspan class="wa-bubble-time"\x3e' + formatTime(a.created_at) + '\x3c/span\x3e' +
                  '\x3c/div\x3e' +
                '\x3c/div\x3e';
      });

      messagesDiv.innerHTML = html;
      if (!isQuietRefresh) messagesDiv.scrollTop = messagesDiv.scrollHeight;
    };

    window.closeChat = () => {
      activeChatKey = null;
      if (window.innerWidth <= 768) {
        document.getElementById('wa-sidebar').classList.remove('chat-open');
        document.getElementById('wa-chat-area').classList.remove('chat-open');
      }
      document.getElementById('wa-chat-empty').style.display = 'flex';
      document.getElementById('wa-chat-view').classList.remove('visible');
      renderList();
    };

    const doAlert = async (id, action) => {
      const body = action === 'dispatch' ? { notes: 'Drugs dispatched' } : action === 'self-resolve' ? { notes: 'Resolved externally' } : {};
      try {
        const res = await fetch('/api/alerts/' + id + '/' + action, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(body),
        });
        if (res.ok) loadAlerts();
        else alert('Action failed. Please try again.');
      } catch (e) {
        alert('Network error.');
      }
    };

    window.resolveWithBatch = (id) => {
      const modal = document.createElement('div');
      modal.className = 'modal-backdrop';
      modal.style.display = 'flex';
      modal.innerHTML = '\x3cdiv class="modal-box"\x3e' + '\x3cdiv class="modal-header"\x3e\x3ch3\x3eConfirm Receipt\x3c/h3\x3e\x3cbutton class="modal-close" onclick="this.closest(\'.modal-backdrop\').remove()"\x3e' + icons.cross + '\x3c/button\x3e\x3c/div\x3e' + '\x3cdiv class="form-group" style="padding:15px 0;"\x3e\x3clabel\x3eBatch Number (Optional)\x3c/label\x3e\x3cinput class="form-control" id="resolve-batch" placeholder="Leave blank for Auto-Batch" /\x3e\x3c/div\x3e' + '\x3cdiv id="resolve-result"\x3e\x3c/div\x3e' + '\x3cdiv class="modal-footer"\x3e\x3cbutton class="btn btn-ghost" onclick="this.closest(\'.modal-backdrop\').remove()"\x3eCancel\x3c/button\x3e\x3cbutton class="btn btn-success" onclick="submitResolve(\'' + id + '\', this)"\x3eMark Received\x3c/button\x3e\x3c/div\x3e' + '\x3c/div\x3e';
      document.body.appendChild(modal);
    };

    window.submitResolve = async (id, btn) => {
      const batch_number = document.getElementById('resolve-batch').value.trim();
      btn.disabled = true;
      btn.textContent = 'Saving...';
      const res = await fetch('/api/alerts/' + id + '/resolve', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ batch_number, notes: 'Drugs received' }),
      });
      if (res.ok) {
        document.querySelector('.modal-backdrop')?.remove();
        loadAlerts();
      } else {
        document.getElementById('resolve-result').innerHTML = '\x3cdiv class="flash flash-error"\x3eFailed to resolve\x3c/div\x3e';
        btn.disabled = false;
        btn.textContent = 'Mark Received';
      }
    };

    window.openNetworkModal = async (drugId, drugName, defaultQty, transactionType, alertType) => {
      const modal = document.createElement('div');
      modal.className = 'modal-backdrop';
      modal.style.display = 'flex';
      modal.innerHTML = '\x3cdiv class="modal-box" style="max-width:750px; border-top: 4px solid #0052CC;"\x3e' + '\x3cdiv class="modal-header" style="border-bottom: 1px solid #eee; padding-bottom: 10px;"\x3e' + '\x3ch3 style="color: #333;"\x3eFetching Network Matches...\x3c/h3\x3e' + '\x3cbutton class="modal-close" onclick="event.stopPropagation(); this.closest(\'.modal-backdrop\').remove()"\x3e' + icons.cross + '\x3c/button\x3e' + '\x3c/div\x3e' + '\x3cdiv class="modal-body" style="padding: 30px 0; text-align: center;"\x3e' + '\x3cdiv class="spinner" style="margin: 0 auto;"\x3e\x3c/div\x3e' + '\x3cp style="margin-top: 15px; color: #666;"\x3eAnalyzing facility tiers and geography...\x3c/p\x3e' + '\x3c/div\x3e\x3c/div\x3e';
      document.body.appendChild(modal);

      try {
        const res = await fetch('/api/alerts/network-matches?drugName=' + encodeURIComponent(drugName) + '&type=' + alertType, { credentials: 'include' });
        const responseData = await res.json();
        if (!res.ok) throw new Error(responseData.message);

        const { priorityMatches, recommended, openNetwork } = responseData.data;
        const inputType = alertType === 'ROP' ? 'checkbox' : 'radio';
        const instructionText = alertType === 'ROP' ? 'Select facilities to request from.' : 'Select ONE facility to offer your discounted stock to.';

        const buildList = (facilities, isPriority = false) => facilities.map((f) => '\x3cdiv class="network-match-card ' + (isPriority ? 'priority-match-card' : '') + '"\x3e' + '\x3cinput type="' + inputType + '" name="facilitySelection" value="' + f.facilityId + '" id="fac-' + f.facilityId + '" data-type="' + f.transactionType + '" class="network-match-checkbox"\x3e' + '\x3clabel for="fac-' + f.facilityId + '" class="network-match-info" style="cursor: pointer; margin: 0;"\x3e' + '\x3cstrong\x3e' + f.name + '\x3c/strong\x3e\x3cspan\x3e' + f.tier + ' • ' + f.state + ' (' + f.lga + ')\x3c/span\x3e' + '\x3clabel\x3e' + '\x3cspan class="badge badge-' + (isPriority ? 'warning' : 'success') + ' network-match-status"\x3e' + f.statusText + '\x3c/span\x3e' + '\x3c/div\x3e').join('');

        modal.querySelector('.modal-box').innerHTML = '\x3cdiv class="modal-header" style="border-bottom: 1px solid #eee; padding-bottom: 10px;"\x3e' + '\x3ch3 style="color: #333;"\x3eConfirm Transaction Details\x3c/h3\x3e' + '\x3cbutton class="modal-close" onclick="event.stopPropagation(); this.closest(\'.modal-backdrop\').remove()"\x3e' + icons.cross + '\x3c/button\x3e' + '\x3c/div\x3e' + '\x3cdiv class="modal-body" style="padding: 15px 0; max-height: 60vh; overflow-y: auto;"\x3e' + '\x3cp style="font-size:0.9rem; color:#8492a6; margin-bottom: 15px;"\x3e' + instructionText + '\x3c/p\x3e' + '\x3cdiv style="background: #f8f9fa; padding: 15px; border-radius: 6px; margin-bottom: 20px;"\x3e' + '\x3cp style="margin-bottom: 8px;"\x3e\x3cstrong\x3eDrug:\x3c/strong\x3e ' + drugName + '\x3c/p\x3e' + '\x3cp style="margin-bottom: 8px;"\x3e\x3cstrong\x3eQuantity:\x3c/strong\x3e ' + defaultQty + '\x3c/p\x3e' + '\x3cdiv style="margin-top: 10px;"\x3e' + '\x3clabel style="font-size: 0.85rem; font-weight: bold;"\x3eConfirm Unit Metric:\x3c/label\x3e' + '\x3cselect class="form-control" id="draft-unit" style="margin-top: 4px;"\x3e' + '\x3coption value="Carton"\x3eCarton\x3c/option\x3e\x3coption value="Roll"\x3eRoll\x3c/option\x3e\x3coption value="Pack" selected\x3ePack\x3c/option\x3e\x3coption value="Card"\x3eCard\x3c/option\x3e\x3coption value="Bottle"\x3eBottle\x3c/option\x3e\x3coption value="Pieces"\x3ePieces\x3c/option\x3e' + '\x3c/select\x3e' + '\x3c/div\x3e' + '\x3c/div\x3e' + (priorityMatches && priorityMatches.length > 0 ? '\x3ch4 style="display: flex; align-items: center; font-size: 1rem; margin-bottom: 10px; color: #c05621;"\x3ePriority Matches (Waste vs Want)\x3c/h4\x3e' + buildList(priorityMatches, true) : '') + '\x3ch4 style="display: flex; align-items: center; font-size: 1rem; margin-top: 20px; margin-bottom: 10px; color: #2b6cb0;"\x3eRecommended Network Matches\x3c/h4\x3e' + (recommended.length > 0 ? buildList(recommended) : '\x3cp style="font-size: 0.85rem; color: #a0aec0; margin-bottom: 15px;"\x3eNo standard peer-tier facilities found in your state.\x3c/p\x3e') + '\x3ch4 style="display: flex; align-items: center; font-size: 1rem; margin-top: 20px; margin-bottom: 10px; color: #4a5568;"\x3eOpen Network Directory\x3c/h4\x3e' + (openNetwork.length > 0 ? buildList(openNetwork) : '\x3cp style="font-size: 0.85rem; color: #a0aec0;"\x3eNo additional facilities available.\x3c/p\x3e') + '\x3c/div\x3e' + '\x3cdiv id="transfer-result"\x3e\x3c/div\x3e' + '\x3cdiv class="modal-footer" style="border-top: 1px solid #eee; padding-top: 15px; display: flex; justify-content: flex-end; gap: 10px;"\x3e' + '\x3cbutton class="btn btn-ghost" onclick="event.stopPropagation(); this.closest(\'.modal-backdrop\').remove()"\x3eCancel\x3c/button\x3e' + '\x3cbutton class="btn btn-success" style="width: 250px; font-weight: bold; font-size: 1.05rem;" onclick="submitNetworkTransfers(\'' + drugId + "', " + defaultQty + ', this)"\x3eConfirm & Transmit\x3c/button\x3e' + '\x3c/div\x3e';
      } catch (err) {
        modal.querySelector('.modal-body').innerHTML = '\x3cdiv class="flash flash-error"\x3e' + (err.message || 'Failed to fetch network directory.') + '\x3c/div\x3e';
      }
    };

    window.submitNetworkTransfers = async (drugId, defaultQty, btn) => {
      const resultDiv = document.getElementById('transfer-result');
      const unit = document.getElementById('draft-unit').value;
      const selectedInputs = document.querySelectorAll('input[name="facilitySelection"]:checked');

      if (selectedInputs.length === 0) {
        resultDiv.innerHTML = '\x3cdiv class="flash flash-error"\x3ePlease select at least one facility.\x3c/div\x3e';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Transmitting...';

      try {
        const promises = Array.from(selectedInputs).map(async (input) => {
          const draftRes = await fetch('/api/alerts/transfer/draft', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ providerFacilityId: input.value, drugId: drugId, quantityRequested: defaultQty, unit: unit, transactionType: input.getAttribute('data-type') }),
          });
          const draftData = await draftRes.json();
          if (!draftRes.ok) throw new Error(draftData.message);

          const transRes = await fetch('/api/alerts/transfer/' + draftData.draft._id + '/transmit', { method: 'PATCH', credentials: 'include' });
          if (!transRes.ok) throw new Error('Transmission failed');
        });

        await Promise.all(promises);
        resultDiv.innerHTML = '\x3cdiv class="flash flash-success"\x3eTransmitted Successfully!\x3c/div\x3e';
        setTimeout(() => {
          document.querySelector('.modal-backdrop')?.remove();
        }, 1200);
      } catch (err) {
        resultDiv.innerHTML = '\x3cdiv class="flash flash-error"\x3e' + err.message + '\x3c/div\x3e';
        btn.disabled = false;
        btn.textContent = 'Confirm & Transmit';
      }
    };

    loadAlerts();
    setInterval(loadAlerts, 15000);
