extends layout

block content
  style.
    /* Force table to scroll horizontally on mobile and keep headers */
    .mobile-table-scroll {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-radius: 8px;
    }
    .mobile-table-scroll table {
      min-width: 500px; /* Forces scrolling instead of squishing */
    }
    @media (max-width: 768px) {
      .mobile-table-scroll th, .mobile-table-scroll td {
        display: table-cell !important; /* Overrides stacked mobile layouts */
        padding: 10px 8px !important; /* Reduces gap between columns */
        white-space: nowrap;
        text-align: left !important;
      }
      .mobile-table-scroll td::before {
        display: none !important; /* Hides any injected card labels */
      }
    }

  .page-header
    h2.page-title Overview
    .date-filter Today, #{new Date().toLocaleDateString('en-GB')}

  // STATS ROW
  .dashboard-stats
    .stat-card
      .stat-title Total Sales Today
      .stat-value#total-sales-value ₦0
    .stat-card
      .stat-title Prescriptions Filled
      .stat-value#rx-filled-value 0
    .stat-card
      .stat-title Low Stock Alerts
      .stat-value.danger#low-stock-value 0
      
  .dashboard-grid
    // RECENT SALES
    .card
      .card-header(style="display:flex; justify-content:space-between; align-items:center;")
        .card-title RECENT SALES
        a.btn.btn-ghost.btn-sm(href='/sales') VIEW ALL
      
      .mobile-table-scroll
        table.table(style="width: 100%;")
          thead
            tr
              th Drug
              th Quantity
              th Status
              th Time
          tbody#recent-sales
            tr
              td(colspan="4")
                .loader
                  .spinner
                  |  Loading...

    // ACTIVE ALERTS
    .card
      .card-header(style="display:flex; justify-content:space-between; align-items:center;")
        .card-title ACTIVE ALERTS
        a.btn.btn-ghost.btn-sm(href='/alerts') GO TO DSS
      #recent-alerts
        .loader
          .spinner
          |  Loading...

block scripts
  script.
    document.addEventListener('DOMContentLoaded', () => {
      // Fetch Sales
      fetch('/api/sales', { credentials: 'include' })
        .then(res => res.json())
        .then(data => {
          const sales = data.sales || [];
          document.getElementById('rx-filled-value').textContent = sales.length;
          
          const today = new Date().toDateString();
          const todaySales = sales.filter(s => new Date(s.created_at).toDateString() === today);
          const totalRev = todaySales.reduce((sum, s) => sum + ((s.quantity_sold || 0) * (s.unit_price || 0)), 0);
          document.getElementById('total-sales-value').textContent = '₦' + totalRev.toLocaleString();

          const tbody = document.getElementById('recent-sales');
          if (!sales.length) {
            tbody.innerHTML = `<tr><td colspan="4"><div class="empty-state"><div class="empty-state-icon" style="color: #a0aec0; margin-bottom:10px;"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 1.95-1.57L23 6H6"></path></svg></div><p>No sales yet today</p></div></td></tr>`;
            return;
          }
          
          tbody.innerHTML = sales.slice(0, 6).map((s) => {
            const time = new Date(s.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            let statusBadge = '<span class="badge badge-ok">Completed</span>';
            if (s.snapshot && s.snapshot.rop_triggered) {
               statusBadge = '<span class="badge badge-low" style="background:#fee2e2; color:#dc2626;">Triggered</span>';
            }
            return `
              <tr>
                <td style="font-weight: 500;">${s.drug_id ? s.drug_id.drug_name : (s.snapshot ? s.snapshot.drug_name : 'Unknown')}</td>
                <td>${s.quantity_sold} ${s.drug_id && s.drug_id.unit ? s.drug_id.unit : 'units'}</td>
                <td>${statusBadge}</td>
                <td style="color: #64748b;">${time}</td>
              </tr>
            `;
          }).join('');
        })
        .catch(err => {
            document.getElementById('recent-sales').innerHTML = `<tr><td colspan="4" class="flash-error">Failed to load sales data</td></tr>`;
        });

      // Fetch Alerts
      fetch('/api/alerts', { credentials: 'include' })
        .then(res => res.json())
        .then(data => {
          const alerts  = data.alerts || [];
          const wrapper = document.getElementById('recent-alerts');

          const activeLowStock = alerts.filter(a => a.type === 'ROP' && a.status === 'pending');
          document.getElementById('low-stock-value').textContent = activeLowStock.length;

          if (!alerts.length) {
            wrapper.innerHTML = `<div class="empty-state"><div class="empty-state-icon" style="color: #a0aec0; margin-bottom:10px;"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg></div><p>No active alerts</p></div>`;
            return;
          }

          wrapper.innerHTML = alerts.slice(0, 3).map(a => {
            const isROP = a.type === 'ROP';
            const icon = isROP 
              ? `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`
              : `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`;
            
            return `
              <div class="alert-item" style="display:flex; align-items:flex-start; gap:12px; padding: 12px; border-bottom: 1px solid #f1f5f9;">
                <div class="alert-icon" style="padding-top:2px;">${icon}</div>
                <div class="alert-content" style="flex:1;">
                  <div style="font-weight:600; margin-bottom:4px; display:flex; justify-content:space-between;">
                    <span>${a.drug_name}</span>
                    <span class="badge ${isROP ? 'badge-warning' : 'badge-low'}">${a.type}</span>
                  </div>
                  <div style="font-size:0.85rem; color:#64748b;">${a.notes}</div>
                </div>
              </div>
            `;
          }).join('');
        })
        .catch(err => {
            document.getElementById('recent-alerts').innerHTML = `<div class="flash flash-error">Failed to load alerts</div>`;
        });
    });