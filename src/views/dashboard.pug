extends layout

block content
  .stats-grid
    a.stat-card(href='/inventory' style='text-decoration:none;cursor:pointer')
      .stat-icon.blue
        svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' width='22' height='22')
          path(d='M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z')
      .stat-info
        .stat-number#total-drugs 0
        .stat-label Total Drugs

    a.stat-card(href='/inventory?filter=low_stock' style='text-decoration:none;cursor:pointer')
      .stat-icon.red
        svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' width='22' height='22')
          polyline(points='22 12 18 12 15 21 9 3 6 12 2 12')
      .stat-info
        .stat-number#low-stock 0
        .stat-label Low Stock (ROP)

    a.stat-card(href='/inventory?filter=expiring' style='text-decoration:none;cursor:pointer')
      .stat-icon.orange
        svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' width='22' height='22')
          circle(cx='12' cy='12' r='10')
          polyline(points='12 6 12 12 16 14')
      .stat-info
        .stat-number#expiring 0
        .stat-label Expiring/Expired (FEFO)

    a.stat-card(href='/sales' style='text-decoration:none;cursor:pointer')
      .stat-icon.green
        svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' width='22' height='22')
          circle(cx='9' cy='21' r='1')
          circle(cx='20' cy='21' r='1')
          path(d='M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 001.95-1.57L23 6H6')
      .stat-info
        .stat-number#total-sales 0
        .stat-label Sales Today

  .grid-2
    .card
      .card-title
        span Recent Sales
        a.btn.btn-sm.btn-ghost(href='/sales') View All
      .compact-table-wrapper
        table.compact-table
          thead
            tr
              th(style="font-weight: 600; color: #64748b; font-size: 0.85rem;") Drug
              th(style="font-weight: 600; color: #64748b; font-size: 0.85rem;") Quantity Sold
              th(style="font-weight: 600; color: #64748b; font-size: 0.85rem;") ROP Alert
              th(style="font-weight: 600; color: #64748b; font-size: 0.85rem;") Time
          tbody#recent-sales
            tr
              td(colspan='4')
                .loader
                  .spinner
                  |  Loading...

    .card
      .card-title
        span Active Alerts
        a.btn.btn-sm.btn-ghost(href='/alerts') View All
      #recent-alerts
        .loader
          .spinner
          |  Loading...

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {

      // ─── FETCH INVENTORY STATS ───
      fetch('/api/inventory', { credentials: 'include' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var drugs   = data.drugs || [];
          var today   = new Date();

          var lowStock = drugs.filter(function(d) { 
              return d.total_quantity <= d.reorder_point; 
          }).length;
          
          var expiring = drugs.filter(function(d) {
            if (!d.batches || !d.batches.length) return false;
            return d.batches.some(function(b) {
               var days = Math.ceil((new Date(b.expiry_date) - today) / 86400000);
               return days <= (d.expiry_alert_days || 180); 
            });
          }).length;

          if(window.countUp) {
              countUp(document.getElementById('total-drugs'), drugs.length);
              countUp(document.getElementById('low-stock'),   lowStock);
              countUp(document.getElementById('expiring'),    expiring);
          } else {
              document.getElementById('total-drugs').textContent = drugs.length;
              document.getElementById('low-stock').textContent = lowStock;
              document.getElementById('expiring').textContent = expiring;
          }
        });

      // ─── FETCH RECENT SALES ───
      fetch('/api/sales', { credentials: 'include' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var sales = data.sales || [];
          var today = new Date().toDateString();
          var todaySales = sales.filter(function(s) { 
              return new Date(s.created_at).toDateString() === today; 
          });

          if(window.countUp) {
              countUp(document.getElementById('total-sales'), todaySales.length);
          } else {
              document.getElementById('total-sales').textContent = todaySales.length;
          }

          var tbody = document.getElementById('recent-sales');
          if (!sales.length) {
            tbody.innerHTML = '\x3ctr\x3e\x3ctd colspan="4" style="text-align:center; padding:2rem !important;"\x3e\x3cdiv class="empty-state"\x3e\x3cp\x3eNo sales yet today\x3c/p\x3e\x3c/div\x3e\x3c/td\x3e\x3c/tr\x3e';
            return;
          }
          
          tbody.innerHTML = sales.slice(0, 6).map(function(s, i) {
            var drugName = s.snapshot && s.snapshot.drug_name ? s.snapshot.drug_name : 'Unknown';
            var ropTriggered = s.snapshot && s.snapshot.rop_triggered ? true : false;
            var badgeClass = ropTriggered ? 'badge-low' : 'badge-ok';
            var badgeText = ropTriggered ? 'Triggered' : 'Normal';
            var timeText = new Date(s.created_at).toLocaleTimeString('en-NG', { hour:'2-digit', minute:'2-digit' });
            
            return '\x3ctr style="animation-delay:' + (i * 0.05) + 's"\x3e' +
              '\x3ctd\x3e\x3cstrong style="color: #334155;"\x3e' + drugName + '\x3c/strong\x3e\x3c/td\x3e' +
              '\x3ctd style="color: #475569;"\x3e' + s.quantity_sold + ' units\x3c/td\x3e' +
              '\x3ctd\x3e\x3cspan class="badge ' + badgeClass + '"\x3e' + badgeText + '\x3c/span\x3e\x3c/td\x3e' +
              '\x3ctd style="color:#8492a6;"\x3e' + timeText + '\x3c/td\x3e' +
            '\x3c/tr\x3e';
          }).join('');
        });

      // ─── FETCH RECENT ALERTS (WHATSAPP SYNCED) ───
      fetch('/api/alerts', { credentials: 'include' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var alerts  = data.alerts || [];
          var wrapper = document.getElementById('recent-alerts');

          // Group by Drug just like the main Alerts page
          var groupedAlerts = {};
          alerts.forEach(function(a) {
              var key = a.drug_name || 'System Alert';
              if (!groupedAlerts[key]) {
                  groupedAlerts[key] = { drugName: key, alerts: [], unread: 0, latestTime: new Date(0), latestMsg: '' };
              }
              groupedAlerts[key].alerts.push(a);
          });

          for (var key in groupedAlerts) {
              var group = groupedAlerts[key];
              group.alerts.sort(function(a, b) { 
                  return new Date(a.created_at) - new Date(b.created_at); 
              });
              
              var latest = group.alerts[group.alerts.length - 1];
              group.latestTime = new Date(latest.created_at);
              
              if (latest.isTransfer) group.latestMsg = 'Network Transfer';
              else if (latest.type === 'ROP') group.latestMsg = 'Low Stock (ROP)';
              else group.latestMsg = 'Expiring Stock (FEFO)';

              group.unread = group.alerts.filter(function(a) { 
                  return a.status === 'pending' && !a.is_read; 
              }).length;
          }

          var groupsArray = Object.values(groupedAlerts).sort(function(a, b) { 
              return b.latestTime - a.latestTime; 
          });

          // Filter for drugs that have unread items or are currently pending/dispatched
          var activeGroups = groupsArray.filter(function(g) {
              return g.unread > 0 || g.alerts.some(function(a) { 
                  return ['pending', 'confirmed', 'dispatched'].includes(a.status); 
              });
          });

          if (!activeGroups.length) {
            wrapper.innerHTML = '\x3cdiv class="empty-state" style="text-align:center; padding:2rem;"\x3e\x3cp\x3eNo active alerts\x3c/p\x3e\x3c/div\x3e';
            return;
          }

          var getWhatsAppDateStr = function(dateInput) {
              var date = new Date(dateInput);
              var today = new Date();
              var yesterday = new Date(today);
              yesterday.setDate(yesterday.getDate() - 1);

              if (date.toDateString() === today.toDateString()) return 'Today';
              if (date.toDateString() === yesterday.toDateString()) return 'Yesterday';

              var diffTime = Math.abs(today - date);
              var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

              if (diffDays < 7) return date.toLocaleDateString('en-US', { weekday: 'long' }); 
              return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
          };

          var formatTime = function(dateString) {
              return new Date(dateString).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
          };

          // Build exact WhatsApp-style contact rows directly in the card!
          wrapper.innerHTML = activeGroups.slice(0, 4).map(function(g) {
              var timeStr = getWhatsAppDateStr(g.latestTime) === 'Today' ? formatTime(g.latestTime) : getWhatsAppDateStr(g.latestTime);
              
              var unreadHtml = g.unread > 0 
                  ? '\x3cspan class="wa-unread"\x3e' + g.unread + '\x3c/span\x3e' 
                  : '';

              return '\x3cdiv class="wa-drug-row" onclick="window.location.href=\'/alerts\'" style="border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px; padding: 12px 16px; background: #fff;"\x3e' +
                       '\x3cdiv class="wa-drug-info"\x3e' +
                           '\x3cdiv class="wa-drug-name"\x3e' + g.drugName + '\x3c/div\x3e' +
                           '\x3cdiv class="wa-drug-preview"\x3e' + g.latestMsg + '\x3c/div\x3e' +
                       '\x3c/div\x3e' +
                       '\x3cdiv class="wa-drug-meta"\x3e' +
                           '\x3cspan class="wa-time"\x3e' + timeStr + '\x3c/span\x3e' +
                           unreadHtml +
                       '\x3c/div\x3e' +
                   '\x3c/div\x3e';
          }).join('');
        });
    }); 