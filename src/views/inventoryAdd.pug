extends layout

block content
  .page-header
    h2.page-title Add Drug
    a.btn.btn-ghost(href='/inventory') ← Back

  .card
    form#add-drug-form
      .form-row
        .form-group
          label Drug Name
          input.form-control(type='text' id='drug_name' placeholder='e.g Amoxicillin' required)
        .form-group
          label Generic Name
          input.form-control(type='text' id='generic_name' placeholder='e.g Amoxicillin Trihydrate')
      .form-row
        .form-group
          label Category
          select.form-control#category
            option(value='') -- Select --
            option antibiotic
            option analgesic
            option antiviral
            option antifungal
            option vitamin
            option other
        .form-group
          label Unit
          select.form-control#unit
            option tablet
            option capsule
            option vial
            option ml
            option sachet
      .form-row
        .form-group
          label General Drug Barcode (UPC)
          input.form-control(type='text' id='barcode' placeholder='Scan product box barcode')
        .form-group
          label Reorder Point
          input.form-control(type='number' id='reorder_point' placeholder='e.g 50' required)
      .form-row
        .form-group
          label Expiry Alert Days
          input.form-control(type='number' id='expiry_alert_days' placeholder='e.g 180' value='180')

      h3(style='margin:1.5rem 0 1rem; font-size:1rem; color:#343a40') First Batch
      .form-row
        .form-group
          label Batch Number (Auto-Generated)
          input.form-control(type='text' id='batch_number' required readonly style="background:#f8fafc; color:#a0aec0; cursor:not-allowed;")
        .form-group
          label Quantity
          input.form-control(type='number' id='quantity' placeholder='e.g 200' required)
      .form-row
        .form-group
          label Specific Batch Barcode (Optional)
          input.form-control(type='text' id='batch_barcode' placeholder='Scan specific batch 2D barcode')
        .form-group
          label Expiry Date
          input.form-control(type='date' id='expiry_date' required)
      .form-row
        .form-group
          label Unit Price (₦)
          input.form-control(type='number' id='unit_price' placeholder='e.g 150')
    
      #add-result
      button.btn.btn-primary(type='submit' style="width:100%; justify-content:center; padding:0.85rem;") Add Drug

block scripts
  script.
    document.addEventListener('DOMContentLoaded', () => {
      // Clean, sequential starting batch
      document.getElementById('batch_number').value = 'BATCH-001';
    });

    document.getElementById('add-drug-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const result = document.getElementById('add-result');
      result.innerHTML = '<div class="loader"><div class="spinner"></div> Adding drug...</div>';

      const body = {
        drug_name:         document.getElementById('drug_name').value,
        generic_name:      document.getElementById('generic_name').value,
        category:          document.getElementById('category').value,
        unit:              document.getElementById('unit').value,
        barcode:           document.getElementById('barcode').value.trim() || undefined,
        reorder_point:     parseInt(document.getElementById('reorder_point').value),
        expiry_alert_days: parseInt(document.getElementById('expiry_alert_days').value) || 180,
        batches: [
          {
            batch_number:  document.getElementById('batch_number').value,
            quantity:      parseInt(document.getElementById('quantity').value),
            expiry_date:   document.getElementById('expiry_date').value,
            unit_price:    parseFloat(document.getElementById('unit_price').value) || null,
            batch_barcode: document.getElementById('batch_barcode').value.trim() || undefined,
          },
        ],
      };

      try {
        const res  = await fetch('/api/inventory', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(body),
        });
        const data = await res.json();

        if (res.ok) {
          result.innerHTML = '<div class="flash flash-success">✓ Drug added — redirecting...</div>';
          setTimeout(() => window.location.href = '/inventory', 800);
        } else {
          result.innerHTML = `<div class="flash flash-error">${data.message || 'Failed to add drug'}</div>`;
        }
      } catch (err) {
        result.innerHTML = '<div class="flash flash-error">Something went wrong — try again</div>';
      }
    });