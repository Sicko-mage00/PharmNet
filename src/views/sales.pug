extends layout

block content
  .page-header
    h2.page-title Sales & Dispensing
    
  //- RECORD NEW SALE FORM
  .card(style="margin-bottom: 2rem; border-top: 4px solid var(--success);")
    .card-title Record Dispensed Drug
    form#record-sale-form
      .form-row
        .form-group
          label Select Drug
          select.form-control#drug_select(required)
            option(value='') Loading drugs...
        .form-group
          label Quantity Dispensed
          input.form-control(type='number' id='quantity_sold' min='1' placeholder='e.g 2' required)
      .form-row
        .form-group
          label Unit Price (₦) - Optional
          input.form-control(type='number' id='unit_price' placeholder='e.g 500')
        .form-group
          label Patient Ref/Prescription ID (Optional)
          input.form-control(type='text' id='patient_ref' placeholder='e.g PT-8819')
      
      #sale-result
      button.btn.btn-success(type='submit' style="width:100%; justify-content:center; padding:0.85rem;") Complete Sale

  //- SALES HISTORY TABLE
  .card
    .card-title Sales History
    .compact-table-wrapper
      table.compact-table
        thead
          tr
            th(style="font-weight: 600; color: #64748b; font-size: 0.85rem;") Date & Time
            th(style="font-weight: 600; color: #64748b; font-size: 0.85rem;") Drug Name
            th(style="font-weight: 600; color: #64748b; font-size: 0.85rem;") Qty Sold
            th(style="font-weight: 600; color: #64748b; font-size: 0.85rem;") Batch Used
            th(style="font-weight: 600; color: #64748b; font-size: 0.85rem;") System Alert
            th(style="font-weight: 600; color: #64748b; font-size: 0.85rem;") Dispensed By
        tbody#sales-table
          tr
            td(colspan='6' style='text-align:center;color:#6c757d')
              .loader
                .spinner
                |  Loading...

block scripts
  script.
    document.addEventListener('DOMContentLoaded', () => {

      // ── Populate Drug Dropdown ──
      fetch('/api/inventory', { credentials: 'include' })
        .then(r => r.json())
        .then(data => {
            const select = document.getElementById('drug_select');
            if(!data.drugs || data.drugs.length === 0) {
                select.innerHTML = '<option value="">No drugs available</option>';
                return;
            }
            select.innerHTML = '<option value="">-- Select Drug --</option>' + data.drugs.map(d => 
                `<option value="${d._id}">${d.drug_name} (Stock: ${d.total_quantity} ${d.unit})</option>`
            ).join('');
        });

      // ── Load Sales History ──
      const loadSales = () => {
          fetch('/api/sales', { credentials: 'include' })
          .then(r => r.json())
          .then(data => {
            const sales = data.sales || [];
            const tbody = document.getElementById('sales-table');

            if (!sales.length) {
              tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem !important;"><div class="empty-state"><p>No sales recorded yet.</p></div></td></tr>';
              return;
            }

            tbody.innerHTML = sales.map(s => {
              const drugName = s.snapshot?.drug_name || s.drug_id?.drug_name || 'Unknown Drug';
              const soldBy = s.sold_by ? `${s.sold_by.firstName} ${s.sold_by.lastName}` : 'System';
              const timeStr = isNaN(new Date(s.created_at).getTime()) ? '—' : new Date(s.created_at).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });
              const ropTriggered = s.snapshot?.rop_triggered || false;
              
              return `
                <tr>
                  <td style="white-space:nowrap; color:#4a5568;">${timeStr}</td>
                  <td><strong style="color: #334155;">${drugName}</strong></td>
                  <td style="color: #475569;"><strong>${s.quantity_sold}</strong></td>
                  <td><span style="font-family:monospace; font-size:0.85rem;">${s.batch_number || '—'}</span></td>
                  <td><span class="badge ${ropTriggered ? 'badge-low' : 'badge-ok'}">${ropTriggered ? 'ROP Triggered' : 'Normal'}</span></td>
                  <td style="color:#64748b">${soldBy}</td>
                </tr>
              `;
            }).join('');
          })
          .catch(err => {
              document.getElementById('sales-table').innerHTML = '<tr><td colspan="6"><div class="flash flash-error">Failed to load sales history.</div></td></tr>';
          });
      };

      loadSales();

      // ── Handle Record Sale Form ──
      document.getElementById('record-sale-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = e.target.querySelector('button[type="submit"]');
        const resultDiv = document.getElementById('sale-result');
        
        btn.textContent = 'Processing...';
        btn.disabled = true;
        resultDiv.innerHTML = '';

        const body = {
          drug_id: document.getElementById('drug_select').value,
          quantity_sold: parseInt(document.getElementById('quantity_sold').value),
          unit_price: parseFloat(document.getElementById('unit_price').value) || null,
          patient_ref: document.getElementById('patient_ref').value || ''
        };

        // Enforce a strict 12-second timeout so the UI never hangs forever
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 12000);

        try {
          const res = await fetch('/api/sales', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(body),
            signal: controller.signal
          });
          
          clearTimeout(timeoutId);

          // Check if backend crashed and returned raw HTML instead of JSON
          if (!res.ok && !res.headers.get('content-type')?.includes('application/json')) {
              throw new Error(`Server Error (${res.status}): Backend logic crashed or failed to return JSON.`);
          }

          const data = await res.json();

          if (res.ok) {
            resultDiv.innerHTML = `<div class="flash flash-success" style="margin-bottom:1rem;">✓ Sale recorded! ${data.alerts_triggered > 0 ? '(DSS Alerts Triggered)' : ''}</div>`;
            document.getElementById('record-sale-form').reset();
            loadSales(); 
            
            fetch('/api/inventory', { credentials: 'include' }).then(r => r.json()).then(invData => {
                 document.getElementById('drug_select').innerHTML = '<option value="">-- Select Drug --</option>' + invData.drugs.map(d => 
                    `<option value="${d._id}">${d.drug_name} (Stock: ${d.total_quantity} ${d.unit})</option>`
                 ).join('');
            });
          } else {
            // WE NOW SHOW THE EXACT DATABASE ERROR IN THE UI
            resultDiv.innerHTML = `
              <div class="flash flash-error" style="margin-bottom:1rem;">
                <strong>${data.message || 'Failed to record sale'}</strong>
                ${data.error ? `<br><span style="font-size:0.85rem; font-family:monospace; opacity:0.9; margin-top:5px; display:block;">Details: ${data.error}</span>` : ''}
              </div>`;
          }
        } catch (err) {
          clearTimeout(timeoutId);
          console.error('Sale submission failed:', err);
          
          if (err.name === 'AbortError') {
             resultDiv.innerHTML = `<div class="flash flash-error" style="margin-bottom:1rem;">Request timed out. The server or database is unresponsive. Please restart your server.</div>`;
          } else {
             resultDiv.innerHTML = `<div class="flash flash-error" style="margin-bottom:1rem;">Error: ${err.message || 'Something went wrong.'}</div>`;
          }
        } finally {
          // Guaranteed to unfreeze the button
          btn.textContent = 'Complete Sale';
          btn.disabled = false;
        }
      });
    });